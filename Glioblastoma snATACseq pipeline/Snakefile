# -----------------------------------------------------------------------------
# Ingest
# -----------------------------------------------------------------------------

def _ingest_mode(wildcards):
    return "matrix" if wildcards.cohort in MATRIX_COHORTS else "fragment"

rule ingest:
    """Dispatch by MATRIX_COHORTS membership — matrix-mode uses ingest_matrix.py
    which lifts per-sample peaks onto CATLAS. Fragment-mode uses ingest.py as before."""
    input:
        raw = RAW / "{cohort}",
        catlas_peaks = REF / "catlas_peaks.bed",
    output: PROCESSED / "{cohort}" / "ingested.h5ad"
    log: DATA_ROOT / "logs" / "ingest_{cohort}.log"
    params:
        mode = _ingest_mode
    shell:
        """
        if [ "{params.mode}" = "matrix" ]; then
            python -u src/ingest_matrix.py --cohort {wildcards.cohort} \
                --in {input.raw} --catlas-peaks {input.catlas_peaks} \
                --out {output} 2>&1 | tee {log}
        else
            python -u src/ingest.py --cohort {wildcards.cohort} \
                --in {input.raw} --out {output} 2>&1 | tee {log}
        fi
        """

# -----------------------------------------------------------------------------
# Flatten (fragment-mode only) — replaces the QC/CNV/labels/quantify chain
# -----------------------------------------------------------------------------
# ``src/ingest.py`` writes per-sample snapatac2 h5ads alongside an AnnDataSet
# shell. Downstream vanilla-anndata loads see n_vars=0 and the chain breaks.
# This rule flattens the per-sample h5ads into one cohort-level
# catlas_quantified.h5ad in CATLAS peak space, with marker-peak-based
# cell type labels baked in. Fragment-mode cohorts should use this rule
# instead of the qc → cnv → label_transfer → peak_quantify chain.

rule flatten_cohort:
    """Per-sample snapatac2 h5ads → cohort-level catlas_quantified.h5ad.
    Fragment-mode-only replacement for qc + cnv + labels + peak_quantify."""
    input:
        # Depend on ingested.h5ad as a signal that per-sample files are ready.
        ingested = PROCESSED / "{cohort}" / "ingested.h5ad",
        catlas_bed = REF / "catlas_peaks.bed",
        markers = "config/marker_tsses.tsv",
    output: PROCESSED / "{cohort}" / "catlas_quantified_flat.h5ad"
    log: DATA_ROOT / "logs" / "flatten_{cohort}.log"
    wildcard_constraints:
        cohort = "|".join(c for c in PHASE_A_COHORTS)
    shell:
        """
        python -u src/flatten_cohort.py \
          --per-sample-glob "{PROCESSED}/{wildcards.cohort}/*.h5ad" \
          --cohort {wildcards.cohort} \
          --catlas-bed {input.catlas_bed} \
          --markers-tsv {input.markers} \
          --out {output} 2>&1 | tee {log}
        """

# -----------------------------------------------------------------------------
# QC
# -----------------------------------------------------------------------------

rule qc:
    input: PROCESSED / "{cohort}" / "ingested.h5ad"
    output:
        h5ad = PROCESSED / "{cohort}" / "qc_passed.h5ad",
        report = RESULTS / "qc" / "{cohort}_qc.html",
    log: DATA_ROOT / "logs" / "qc_{cohort}.log"
    shell:
        "python -u src/qc.py --in {input} --out {output.h5ad} "
        "--report {output.report} 2>&1 | tee {log}"

# -----------------------------------------------------------------------------
# CNV-based malignant calling (inferCNVpy; see src/cnv_malignant.py)
# -----------------------------------------------------------------------------

rule cnv_malignant:
    input: PROCESSED / "{cohort}" / "qc_passed.h5ad"
    output: PROCESSED / "{cohort}" / "malignant_called.h5ad"
    log: DATA_ROOT / "logs" / "cnv_{cohort}.log"
    shell:
        "python -u src/cnv_malignant.py --in {input} --out {output} 2>&1 | tee {log}"

# -----------------------------------------------------------------------------
# Dual label transfer (GBmap TME, CATLAS neuronal subtypes, Neftel malignant)
# -----------------------------------------------------------------------------

rule label_transfer:
    input:
        h5ad = PROCESSED / "{cohort}" / "malignant_called.h5ad",
        gbmap = REF / "gbmap.h5ad",
        catlas = REF / "catlas_full_annotated.h5ad",
    output: PROCESSED / "{cohort}" / "labeled.h5ad"
    log: DATA_ROOT / "logs" / "labels_{cohort}.log"
    threads: 16
    shell:
        "python -u src/label_transfer.py "
        "--in {input.h5ad} --gbmap {input.gbmap} --catlas {input.catlas} "
        "--out {output} --threads {threads} 2>&1 | tee {log}"

# -----------------------------------------------------------------------------
# Peak quantification against CATLAS + per-cohort peak-recall QC gate
# -----------------------------------------------------------------------------

def _peak_quantify_mode(wildcards):
    return "passthrough" if wildcards.cohort in MATRIX_COHORTS else "quantify"

rule peak_quantify:
    """For fragment-based cohorts, requantify against CATLAS peaks via snapatac2.
    For matrix-mode cohorts (already in CATLAS space from ingest_matrix.py),
    just pass labeled.h5ad through to catlas_quantified.h5ad."""
    input:
        h5ad = PROCESSED / "{cohort}" / "labeled.h5ad",
        peaks = REF / "catlas_peaks.bed",
    output: PROCESSED / "{cohort}" / "catlas_quantified.h5ad"
    log: DATA_ROOT / "logs" / "quantify_{cohort}.log"
    threads: 16
    params:
        mode = _peak_quantify_mode
    shell:
        """
        if [ "{params.mode}" = "passthrough" ]; then
            cp {input.h5ad} {output}
            echo "matrix-mode cohort {wildcards.cohort} — passthrough (already in CATLAS peak space)" > {log}
        else
            python -u src/peak_quantify.py --in {input.h5ad} --peaks {input.peaks} \
                --out {output} --threads {threads} 2>&1 | tee {log}
        fi
        """

def _peak_recall_threshold(wildcards):
    # Matrix-mode cohorts (lifted from per-sample peak sets) recall far less
    # of CATLAS — Guilhamon's 10x v1 peak set + reciprocal 50% overlap gives
    # ~3% recall. Use 1% here to keep the cohort in; recall is explicitly
    # recorded per-cohort for honest reporting in dataset_issues.
    return "0.01" if wildcards.cohort in MATRIX_COHORTS else "0.50"

rule verify_peak_recall:
    """QC gate: cohort must recall a biologically plausible fraction of CATLAS
    peaks. Fragment-based cohorts should hit ≥50% (anything less suggests wrong
    genome build or over-filtered peaks). Matrix-mode cohorts carry an inherent
    coverage loss from the per-sample-peaks → CATLAS lift; threshold is 5%."""
    input:
        h5ad = PROCESSED / "{cohort}" / "catlas_quantified.h5ad",
        peaks = REF / "catlas_peaks.bed",
    output:
        report = RESULTS / "peak_recall" / "{cohort}.json",
        gate   = PROCESSED / "{cohort}" / "peak_recall.PASS",
    log: DATA_ROOT / "logs" / "peak_recall_{cohort}.log"
    params:
        threshold = _peak_recall_threshold
    shell:
        "python -u -c \""
        "import anndata as ad, json, sys; "
        "a = ad.read_h5ad('{input.h5ad}', backed='r'); "
        "n_peaks_total = a.n_vars; "
        "import numpy as np; "
        "colsum = np.zeros(a.n_vars, dtype=np.float64); chunk = 50000; "
        "[colsum.__iadd__(np.asarray(a.X[i:i+chunk].sum(axis=0)).flatten()) for i in range(0, a.n_obs, chunk)]; "
        "n_peaks_recovered = int((colsum > 0).sum()); "
        "recall = n_peaks_recovered / n_peaks_total; "
        "rec = {{'cohort': '{wildcards.cohort}', 'n_peaks_total': n_peaks_total, "
        "'n_peaks_recovered': n_peaks_recovered, 'recall': recall, 'threshold': {params.threshold}}}; "
        "import pathlib; "
        "pathlib.Path('{output.report}').parent.mkdir(parents=True, exist_ok=True); "
        "open('{output.report}','w').write(json.dumps(rec, indent=2)); "
        "print(f'[recall] {wildcards.cohort}: {{n_peaks_recovered:,}} / {{n_peaks_total:,}} = {{recall:.2%}} (threshold {params.threshold})'); "
        "assert recall >= {params.threshold}, f'Peak recall for {wildcards.cohort} = {{recall:.2%}} < {params.threshold}; cohort excluded.'; "
        "open('{output.gate}','w').write(f'PASS recall={{recall:.4f}}\\n'); "
        "\" 2>&1 | tee {log}"

# -----------------------------------------------------------------------------
# Build the persistent matrix (gated on peak_recall PASS per cohort)
# -----------------------------------------------------------------------------

rule matrix_build:
    input:
        quant = expand(PROCESSED / "{cohort}" / "catlas_quantified.h5ad",
                       cohort=COHORTS_INCLUDE),
        gates = expand(PROCESSED / "{cohort}" / "peak_recall.PASS",
                       cohort=COHORTS_INCLUDE),
    output:
        matrix = MATRIX / "enhancer_candidate_matrix.parquet",
        provenance = MATRIX / "provenance.parquet",
        schema = MATRIX / "MATRIX_SCHEMA.md",
    log: DATA_ROOT / "logs" / "matrix_build.log"
    threads: 32
    shell:
        "python -u src/matrix_build.py --inputs {input.quant} "
        "--matrix {output.matrix} --provenance {output.provenance} "
        "--schema {output.schema} --threads {threads} 2>&1 | tee {log}"

# -----------------------------------------------------------------------------
# Scoring + ranking
# -----------------------------------------------------------------------------

rule score_candidates:
    input: MATRIX / "enhancer_candidate_matrix.parquet"
    output: MATRIX / "candidate_scores.parquet"
    log: DATA_ROOT / "logs" / "scoring.log"
    shell:
        "python -u src/scoring.py --in {input} --out {output} 2>&1 | tee {log}"

rule rank_top_n:
    input: MATRIX / "candidate_scores.parquet"
    output:
        top = MATRIX / "top_candidates.parquet",
        per_ct = expand(str(MATRIX / "per_celltype" / "{ct}.parquet"),
                        ct=config["ranking"]["priority_celltypes_for_r01"]),
    log: DATA_ROOT / "logs" / "ranking.log"
    shell:
        "python -u src/ranking.py --in {input} --top {output.top} "
        "--per-celltype-dir " + str(MATRIX / "per_celltype") + " 2>&1 | tee {log}"

rule surprises:
    input: MATRIX / "enhancer_candidate_matrix.parquet"
    output: MATRIX / "surprises.parquet"
    log: DATA_ROOT / "logs" / "surprises.log"
    shell:
        "python -u src/surprises.py --in {input} --out {output} 2>&1 | tee {log}"

rule dataset_issues:
    input: MATRIX / "enhancer_candidate_matrix.parquet"
    output: MATRIX / "dataset_issues.parquet"
    log: DATA_ROOT / "logs" / "dataset_issues.log"
    shell:
        "python -u src/dataset_issues.py --in {input} --out {output} 2>&1 | tee {log}"

