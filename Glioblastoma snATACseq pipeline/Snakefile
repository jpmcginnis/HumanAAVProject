"""
GBM Enhancer Atlas — orchestrator.
Run on the EC2 after aws_spinup.sh, inside the atacseq conda env, inside the `work` tmux.

Full pipeline:
    snakemake --cores all

Just rebuild the matrix after a config change:
    snakemake matrix_build --forcerun --cores 32

Rescore and rank with a new formula (edit config/pipeline.yaml first):
    snakemake rank_top_n --forcerun --cores 8

Generate the HTML reports:
    snakemake report --cores 4

Reference files (CATLAS peaks/annotation and GBmap) are produced by the
rules at the bottom of this file so a fresh checkout can `--dry-run` cleanly.
"""

import os
import yaml
from pathlib import Path

configfile: "config/pipeline.yaml"
with open("config/datasets.yaml") as f:
    DATASETS = yaml.safe_load(f)

# Phase A — fragment-based cohorts (10x Multiome ARC or h5ad-annotated).
# Phase A.2 — matrix-only cohorts (peak-barcode mtx, lifted to CATLAS by overlap).
# Phase A.3 — Guilhamon + Mathewson (both matrix-mode via per-sample mtx) and
# HRA004942 (Signac RDS extracted → matrix-mode via src/extract_rds.R).
# Phase A.4 — adds gse165037 (SnapATAC v1 RDS extracted via raw-slot bypass in
# src/extract_rds.R, no SnapATAC package needed). GBM-Space (gbm_space) still
# fetching; will join as a fragment-mode cohort when done.
PHASE_A_COHORTS = ["gbm_space", "gse276177_khan_astro", "tcga_scatac"]  # fragment-mode cohorts
PHASE_A2_MATRIX_COHORTS = ["guilhamon", "mathewson_lupien", "gbm_tme_atlas_hra004942", "gse165037", "gse138794_guo"]  # gse276177 moved to fragment-mode
PHASE = os.environ.get("GBM_PHASE", "A")
if PHASE == "A":
    COHORTS_INCLUDE = PHASE_A_COHORTS
elif PHASE == "A2":
    COHORTS_INCLUDE = PHASE_A_COHORTS + PHASE_A2_MATRIX_COHORTS
else:
    COHORTS_INCLUDE = [
        name for name, meta in DATASETS["cohorts"].items()
        if meta["status"] in ("in_pipeline", "partially_in_pipeline", "missing_HIGH_PRIORITY")
        and meta.get("access", "") == "open"
    ]
MATRIX_COHORTS = set(PHASE_A2_MATRIX_COHORTS)
print(f"[Snakefile] PHASE={PHASE}  cohorts: {COHORTS_INCLUDE}  (matrix-mode: {sorted(MATRIX_COHORTS & set(COHORTS_INCLUDE))})")

DATA_ROOT = Path("/data/projects/atacseq")
RAW = DATA_ROOT / "raw"
PROCESSED = DATA_ROOT / "processed"
RESULTS = DATA_ROOT / "results"
REF = DATA_ROOT / "ref"
MATRIX = Path("matrix")
REPORT = Path("reports/out")

# -----------------------------------------------------------------------------
# Top-level targets
# -----------------------------------------------------------------------------

rule all:
    input:
        MATRIX / "enhancer_candidate_matrix.parquet",
        MATRIX / "candidate_scores.parquet",
        MATRIX / "provenance.parquet",
        REPORT / "index.html",
        REPORT / "top_candidates.html",
        REPORT / "surprises.html",
        REPORT / "dataset_issues.html",
        expand(REPORT / "celltypes" / "{ct}.html",
               ct=config["ranking"]["priority_celltypes_for_r01"]),

rule report:
    input:
        REPORT / "index.html",
        REPORT / "top_candidates.html",
        REPORT / "surprises.html",
        REPORT / "dataset_issues.html",

# -----------------------------------------------------------------------------
# Reference data — fetched explicitly so --dry-run can plan a fresh checkout
# -----------------------------------------------------------------------------

rule fetch_catlas:
    """Download the CATLAS 544K-peak snATAC atlas h5ad from the S3 archive."""
    output: REF / "catlas_full_annotated.h5ad"
    log: DATA_ROOT / "logs" / "fetch_catlas.log"
    shell:
        "python -u src/fetch.py --cohort catlas --out {output} 2>&1 | tee {log}"

rule extract_catlas_peaks_bed:
    """Produce the common-coordinate peak BED by reading CATLAS .var."""
    input:  REF / "catlas_full_annotated.h5ad"
    output: REF / "catlas_peaks.bed"
    log:    DATA_ROOT / "logs" / "extract_catlas_peaks_bed.log"
    shell:
        "python -u -c \""
        "import anndata as ad, pandas as pd, sys; "
        "a = ad.read_h5ad('{input}', backed='r'); "
        "v = a.var.copy().reset_index(); "
        "chrom = v['chrom'] if 'chrom' in v.columns else v.iloc[:,0].str.split(':').str[0]; "
        "start_end = v['start'] if 'start' in v.columns else v.iloc[:,0].str.split(':').str[1].str.split('-'); "
        "import re; "
        "idx = pd.DataFrame(v.iloc[:,0].astype(str).str.extract(r'(?P<chrom>chr[\\\\dXYM]+)[:_](?P<start>\\\\d+)[-_](?P<end>\\\\d+)')); "
        "bed = idx.dropna(); bed['start'] = bed['start'].astype(int); bed['end'] = bed['end'].astype(int); "
        "print(f'[peaks] {{len(bed)}} peaks parsed from CATLAS .var'); "
        "bed.to_csv('{output}', sep='\\t', header=False, index=False); "
        "\" 2>&1 | tee {log}"

rule fetch_gbmap:
    """GBmap scRNA reference (Ruiz-Moreno 2025) via cellxgene_census."""
    output: REF / "gbmap.h5ad"
    log:    DATA_ROOT / "logs" / "fetch_gbmap.log"
    shell:
        "python -u src/fetch.py --cohort gbmap --out {output} 2>&1 | tee {log}"

