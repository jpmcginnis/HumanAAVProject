# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ipynb_checkpoints/

# OS cruft
.DS_Store
Thumbs.db

# Secrets — never commit any of these
.env
.env.*
*.pem
*.key
credentials*
*_credentials.*
*secret*
.aws/

# Zenodo-only large data (also > GitHub's 100 MB file limit)
#   The data/matrix/ parquets are deposited at Zenodo (see README).
#   enhancer_candidate_matrix.parquet (366 MB), union_peak_reference.bed (84 MB),
#   peak_provenance.parquet (55 MB), greenwald_fine_pseudobulk_backup.parquet (495 MB).
data/matrix/*.parquet
data/matrix/*.bed

# Large annotated CSVs — regenerated by scripts/build_reports.py from the
# per-report parquets which ARE in-repo. ~50–80 MB each; keep out of git.
reports/detail/*_annotated.csv
reports/detail/per_celltype/*_annotated.csv

# Raw single-cell data — never deposit via git regardless of size
*.h5ad
*.h5ad.gz
*.fragments.tsv.gz
*.tbi

# IDE / scratch
*.swp
*.swo
.vscode/
.idea/
*.tmp
*.bak
~$*   # excel/word lock files
